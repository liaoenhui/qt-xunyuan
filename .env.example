AI_API_KEY=
AI_API_URL=
AI_MODEL=
PROXY_MAX_HEIGHT=480
# 自动检索和代理下载的来源时长上限，默认 10 分钟
SOURCE_MAX_DURATION_SECONDS=600
MAX_DOWNLOAD_CONCURRENCY=2
MAX_PREFLIGHT_CONCURRENCY=3
MAX_ANALYSIS_CONCURRENCY=1
DAILY_TRAFFIC_WARNING_GB=20
CACHE_LIMIT_GB=50
SINGLE_FILE_WARNING_GB=4
DATA_DIR=./data
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YTDLP_BIN=yt-dlp
# 可选，例如 node:C:\path\to\node.exe；留空时自动探测 Deno/Node
YTDLP_JS_RUNTIME=
# 仅填写浏览器名称/资料，不要填写 Cookie、账号或密码，例如 firefox
YTDLP_COOKIES_FROM_BROWSER=
# yt-dlp Netscape 格式 Cookie 文件路径；留空时自动探测项目根目录的 www.youtube.com_cookies.txt，不要提交该文件
YTDLP_COOKIES_FILE=
# 本地 PO Token 服务地址（bgutil-ytdlp-pot-provider），留空表示不启用，例如 http://127.0.0.1:4416
YTDLP_PO_TOKEN_URL=
# yt-dlp 使用的代理，留空表示直连，例如 http://127.0.0.1:7890
YTDLP_PROXY=
YTDLP_SLEEP_INTERVAL=5
YTDLP_MAX_SLEEP_INTERVAL=10
# 下载文件连续无变化多久后自动终止，避免直播/异常来源长期占用队列
YTDLP_STALL_TIMEOUT_SECONDS=120
HOST=127.0.0.1
PORT=8765
# 正式交付 OSS 位置：oss://{OSS_BUCKET}/{OSS_PREFIX}/T{桶}/文件名.mp4
# 这里只记录路径信息，不要填写 AccessKey 等凭据
OSS_BUCKET=futurelab-game-hz
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_PREFIX=game_data/QT寻源全包供应商正式作业/CS
# 共享台账「领取人」列，留空时导出的该列为空，由填表人补
DELIVERY_OWNER=
